<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SISP Core 服务端连接卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sisp_core"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layout_sisp_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tv_sisp_core_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SISP Core：未连接"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_sisp_auto_search"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:indeterminate="true"
                        android:indeterminateTint="#00BCD4"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_sisp_core_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="展开"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_sisp_core_expanded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_sisp_core_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自动搜索中 · 场景及设备操控不可用"
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_tracker_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ByteTrack 服务状态：未启用"
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="终端标识"
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_sisp_terminal_identity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Android 终端"
                        android:textColor="#666666"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_sisp_manual_connect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="手动连接"
                        android:backgroundTint="#455A64"
                        android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:id="@+id/layout_sisp_manual_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="服务端地址"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_sisp_host"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="192.168.1.100"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textColor="#333333"
                            android:textColorHint="#999999"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="端口"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_sisp_port"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:singleLine="true"
                            android:text="8080"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_sisp_connect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="连接"
                            android:backgroundTint="#2196F3"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 调试开关卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="调试显示设置"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"
                    android:layout_marginBottom="12dp"/>

                <!-- 显式设置 textColor 为深色 #333333 -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pose_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用姿态识别 (Pose Mode)"
                    android:textSize="16sp"
                    android:textColor="#333333" 
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示检测框 (Debug Box)"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_show_point"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示中心点 (Center Point)"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:checked="true"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_roi_crop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="启用 Pose ROI 真实裁剪 (Beta)"
                    android:textSize="16sp"
                    android:textColor="#FF9800"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tv_pose_roi_size_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pose ROI比例"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"/>

                <Spinner
                    android:id="@+id/spn_pose_roi_size_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="#FFFFFF"
                    android:popupBackground="#FFFFFF"
                    android:theme="@style/ThemeOverlay.MaterialComponents.Light"
                    android:spinnerMode="dropdown"
                    android:entries="@array/pose_roi_size_labels"
                    android:visibility="gone" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_still_standard_frame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="静止时使用标准帧"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_clipboard_debug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="调试信息写入剪贴板"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pointing_debug_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示 pointing 调试 overlay"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日志更新频率"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spn_roi_log_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:popupBackground="#FFFFFF"
                    android:theme="@style/ThemeOverlay.MaterialComponents.Light"
                    android:spinnerMode="dropdown"
                    android:entries="@array/roi_log_mode_labels" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="人数算法版本"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spn_presence_algorithm_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:popupBackground="#FFFFFF"
                    android:theme="@style/ThemeOverlay.MaterialComponents.Light"
                    android:spinnerMode="dropdown" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_new_tracker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="使用新追踪预测模式"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pause_on_room_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="切换房间后暂停播放"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pause_decision_log_on_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="切换时记录暂停判定日志"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_pause_on_voice_recognize_fail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="识别失败暂停"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tv_pointing_display_mode_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="手势识别线显示时机"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"/>

                <Spinner
                    android:id="@+id/spn_pointing_display_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:popupBackground="#FFFFFF"
                    android:theme="@style/ThemeOverlay.MaterialComponents.Light"
                    android:spinnerMode="dropdown"
                    android:entries="@array/pointing_debug_display_mode_labels" />

                <LinearLayout
                    android:id="@+id/layout_hand_detection_params_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="手部检测参数调节"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hand_detection_params_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="展开"
                        android:textColor="#666666"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_hand_detection_params"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手部检测置信度"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_hand_detection_confidence_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:text="0.50"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/sb_hand_detection_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="手部存在置信度"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_hand_presence_confidence_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:text="0.50"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/sb_hand_presence_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="手部跟踪置信度"
                        android:textColor="#333333"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_hand_tracking_confidence_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp"
                        android:text="0.50"
                        android:textColor="#666666"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/sb_hand_tracking_confidence"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="漏检自动暂停窗口 (ms)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_smart_match_pause"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="智能检测匹配暂停"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingVertical="8dp" />

                <TextView
                    android:id="@+id/tv_event_miss_pause_window_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="500 ms"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp" />

                <SeekBar
                    android:id="@+id/sb_event_miss_pause_window"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="9"
                    android:progress="4" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 功能入口卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_room_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_mapmode"
                    app:tint="#4CAF50" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="区域规划与设置"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="配置客厅主区域和各个房间出入口"
                        android:textSize="12sp"
                        android:textColor="#999999"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="#CCCCCC"
                    android:rotation="0" /> 
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 数据备份与恢复卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="房间配置管理"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#673AB7"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="当前房间配置另存为"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btn_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="读取当前视频配置"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btn_import_other_video_config"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="载入其他视频的配置文件"
                    android:backgroundTint="#9C27B0"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:id="@+id/layout_config_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 测试视频来源卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="测试视频来源"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#009688"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btn_select_video"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择测试视频"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"/>

                <LinearLayout
                    android:id="@+id/layout_video_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <Button
            android:id="@+id/btn_clear_room_counts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="清空所有房间人数"
            android:textColor="#FFFFFF"
            android:backgroundTint="#607D8B"
            android:layout_marginBottom="8dp"/>

        <!-- 全局操作 -->
        <!-- 显式设置 textColor 为红色 -->
        <Button
            android:id="@+id/btn_reset_trackers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="重置所有追踪器状态"
            android:textColor="#FF5722"
            android:backgroundTint="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="#FF5722" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
