<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sisp_splash">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop"
        android:src="@drawable/sisp_splash" />

    <LinearLayout
        android:id="@+id/splashLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="42dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_sisp_loading_chip"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:includeFontPadding="false"
            android:text="进入 SISP"
            android:textColor="#2E5EA8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/dotOne"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_sisp_loading_dot" />

        <View
            android:id="@+id/dotTwo"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_sisp_loading_dot" />

        <View
            android:id="@+id/dotThree"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_sisp_loading_dot" />
    </LinearLayout>
</FrameLayout>
