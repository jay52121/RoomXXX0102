<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. 视频/相机层 -->
    <TextureView
        android:id="@+id/textureView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/liveFrozenFrameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeAudioScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 2. 检测覆盖层 -->
    <com.example.roomxxx0102.ui.views.DetectionOverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. 实时计数器 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="#AA000000"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp">
        <TextView
            android:id="@+id/tvRoomCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/room_people_count_initial"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="12dp"
            app:drawableStartCompat="@android:drawable/ic_menu_myplaces"
            app:drawableTint="#4CAF50"
            android:drawablePadding="8dp" />
    </androidx.cardview.widget.CardView>

    <!-- 4. 编辑层 -->
    <com.example.roomxxx0102.ui.views.LivingRoomEditorView
        android:id="@+id/editorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 5. 左侧控制键：上下分组，保留中间视频主体区域 -->
    <LinearLayout
        android:id="@+id/llNormalControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="0dp"
        android:background="@drawable/bg_side_action_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <Button
            android:id="@+id/btnRadar"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:text="🗺️ 雷达"
            android:background="@drawable/bg_side_action_button"
            android:textColor="#F2F7FF"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:text="[ 播放中 ]"
            android:background="@drawable/bg_side_action_button"
            android:textColor="#F2F7FF"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="92dp" />

        <Button
            android:id="@+id/btnRewind"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:text="-5s"
            android:background="@drawable/bg_side_action_button_dim"
            android:textColor="#9FB4D0"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp" />

        <Button
            android:id="@+id/btnForward"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:text="+5s"
            android:background="@drawable/bg_side_action_button_dim"
            android:textColor="#9FB4D0"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp" />
    </LinearLayout>

    <!-- 5.1 右侧功能键：利用 21:9 屏幕右侧空白区竖排显示 -->
    <LinearLayout
        android:id="@+id/llRightActionControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="0dp"
        android:background="@drawable/bg_side_action_panel"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_side_action_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="系统设置"
            android:textAllCaps="false"
            android:textColor="#F2F7FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSetupRoom"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_side_action_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="房间设置"
            android:textAllCaps="false"
            android:textColor="#F2F7FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDebugPanel"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginBottom="7dp"
            android:background="@drawable/bg_side_action_button_dim"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="调试面板"
            android:textAllCaps="false"
            android:textColor="#9FB4D0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHandOverlay"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_side_action_button"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="看人视图"
            android:textAllCaps="false"
            android:textColor="#F2F7FF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRuntimeMode"
            android:layout_width="86dp"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_side_action_button_active"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:text="回顾模式"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5.5 事件标注工具栏（仅静止/暂停 + 调试面板开启时显示） -->
    <LinearLayout
        android:id="@+id/llEventMarkerControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="100dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:background="#66000000"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMarkEnterEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="记录进子房间事件"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnMarkExitEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="记录出子房间事件"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnJumpNextEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="跳转到下一个事件"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnDeleteCurrentEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="删除当前事件" />
    </LinearLayout>

    <!-- 6. 编辑工具栏 (顶部) -->
    <LinearLayout
        android:id="@+id/llEditorControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/abc_popup_background_mtrl_mult" 
        android:backgroundTint="#1A000000"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llEditorLeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Spinner: 移除 theme 属性 -->
            <Spinner
                android:id="@+id/spnEditMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@android:color/white"
                android:spinnerMode="dropdown"
                android:layout_marginEnd="16dp"/>

            <!-- 客厅模式按键 -->
            <Button
                android:id="@+id/btnUndo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/undo"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear"
                android:layout_marginEnd="8dp"/>

            <!-- 次房间选中后显示的按键 (默认 GONE) -->
            <Button
                android:id="@+id/btnRenameRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rename"
                android:backgroundTint="#9C27B0"
                android:textColor="#F2F7FF"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDeleteRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete"
                android:backgroundTint="#F44336"
                android:textColor="#F2F7FF"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llEditorRight"
            android:layout_width="wrap_content"
            android:layout_gravity="end"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/abc_popup_background_mtrl_mult"
            android:backgroundTint="#1A000000"
            android:padding="8dp">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnFinish"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/finish"
                android:backgroundTint="#4CAF50"
                android:textColor="#F2F7FF"
                android:layout_marginEnd="8dp"/>

            <!-- 关闭按钮 -->
            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:contentDescription="关闭编辑" />
        </LinearLayout>

    </LinearLayout>

    <!-- 7. 雷达地图层 (默认隐藏) -->
    <FrameLayout
        android:id="@+id/flRadarContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="10dp">

        <com.example.roomxxx0102.ui.views.TacticalMapView
            android:id="@+id/tacticalMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageButton
            android:id="@+id/btnCloseRadar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/abc_popup_background_mtrl_mult" 
            android:backgroundTint="#80000000"
            android:padding="8dp"
            app:tint="#FFFFFF"
            android:contentDescription="关闭雷达" />
    </FrameLayout>
    
    <!-- 设备设置层 (默认隐藏) -->
    <LinearLayout
        android:id="@+id/llDeviceSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#80000000"
        android:padding="24dp"
        android:visibility="gone">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备管理 (开发中)"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>
            
        <Button
            android:id="@+id/btnAddDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加设备" />
            
    </LinearLayout>

    <TextView
        android:id="@+id/runtimeSwitchLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_sisp_loading_chip"
        android:elevation="80dp"
        android:includeFontPadding="false"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:text="正在切换…"
        android:textColor="#2E5EA8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/mainSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_sisp_splash"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/sisp_splash" />

        <LinearLayout
            android:id="@+id/mainSplashLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="42dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/bg_sisp_loading_chip"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:includeFontPadding="false"
                android:text="进入 SISP"
                android:textColor="#2E5EA8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/mainSplashDotOne"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_sisp_loading_dot" />

            <View
                android:id="@+id/mainSplashDotTwo"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_sisp_loading_dot" />

            <View
                android:id="@+id/mainSplashDotThree"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_sisp_loading_dot" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
